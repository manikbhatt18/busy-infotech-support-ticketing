generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERVISOR
  AGENT
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role     @default(AGENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedTickets Ticket[]             @relation("PrimaryAssignee")
  collaboratingOn TicketCollaborator[]
  authoredReplies Reply[]
  auditEvents     AuditTimeline[]
  slaAcks         SlaAcknowledgment[]
}

model Ticket {
  id              String         @id @default(uuid())
  subject         String
  description     String
  requesterEmail  String
  priority        TicketPriority @default(MEDIUM)
  category        String
  status          TicketStatus   @default(NEW)
  isArchived      Boolean        @default(false)

  primaryAssigneeId String?
  primaryAssignee   User?   @relation("PrimaryAssignee", fields: [primaryAssigneeId], references: [id])

  // SLA tracking fields
  slaTargetAt      DateTime? // Absolute deadline for the next response breach
  pendingEnteredAt DateTime? // Set when status -> PENDING. Null otherwise.

  resolvedAt DateTime?
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collaborators TicketCollaborator[]
  replies       Reply[]
  timeline      AuditTimeline[]
  slaAcks       SlaAcknowledgment[]
}

model TicketCollaborator {
  ticketId String
  userId   String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
}

enum ReplyAuthorType {
  AGENT
  CUSTOMER
}

model Reply {
  id         String          @id @default(uuid())
  body       String
  isInternal Boolean         @default(false)
  authorType ReplyAuthorType

  // Only set when authorType = AGENT; null for customer replies
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  auditEvents AuditTimeline[]
}

enum AuditEventType {
  TICKET_CREATED
  STATUS_CHANGED
  REASSIGNED
  REPLY_ADDED
}

model AuditTimeline {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  eventType AuditEventType

  // Contextual data depending on eventType
  oldStatus     TicketStatus?
  newStatus     TicketStatus?
  oldAssigneeId String?
  newAssigneeId String?
  replyId       String?
  reply         Reply?         @relation(fields: [replyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model SlaAcknowledgment {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  agentId String
  agent   User   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  breachTime     DateTime // Tracks which specific breach instance was acknowledged
  acknowledgedAt DateTime @default(now())

  @@unique([ticketId, agentId, breachTime])
}
